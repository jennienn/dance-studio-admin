# Supabase 프로젝트 생성 후 Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 서버 전용 (절대 클라이언트에 노출 금지, .env.local에만 저장)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 알림톡 발송 대행사 (SOLAPI) - 모두 서버 전용이며 실제 값은 커밋하지 않음
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
KAKAO_CHANNEL_ID=
KAKAO_SENDER_PHONE=
# 아래 4개 ID는 용도별 템플릿과 정확히 짝지어 등록
KAKAO_DUE_SOLO_TEMPLATE_ID=
KAKAO_DUE_GROUP_TEMPLATE_ID=
KAKAO_COMPLETED_SOLO_TEMPLATE_ID=
KAKAO_COMPLETED_GROUP_TEMPLATE_ID=
# 템플릿 승인·내부번호 테스트·Vercel 환경변수 등록이 모두 끝난 뒤에만 true
NEXT_PUBLIC_NOTIFICATIONS_ENABLED=false

# Vercel Cron이 자동으로 Authorization: Bearer {CRON_SECRET} 헤더를 보내는 데 쓰는 변수.
# 반드시 이 이름(CRON_SECRET) 그대로 Vercel 프로젝트 환경변수에 등록할 것.
CRON_SECRET=change-this-to-a-random-16+char-string
BOOKING_SESSION_SECRET=change-this-to-an-independent-random-32+char-string
