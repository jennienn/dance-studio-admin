{
  "name": "dance-studio-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "TEST_MODE=true vitest run --config vitest.integration.config.ts",
    "test:e2e": "TEST_MODE=true playwright test",
    "test:seed": "TEST_MODE=true tsx scripts/test-seed.ts",
    "test:cleanup": "TEST_MODE=true tsx scripts/test-cleanup.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "notifications:check": "node scripts/check-notification-readiness.mjs",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.78.0",
    "geist": "^1.7.2",
    "next": "^15.5.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "dotenv": "16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.20",
    "supabase": "2.109.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.3"
  }
}
